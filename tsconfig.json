{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "strict": true, // Bật chế độ kiểm tra kiểu nghiêm ngặt toàn diện (bao gồm strictNullChecks, noImplicitAny, v.v.)
    "strictPropertyInitialization": false, // Tắt cảnh báo khởi tạo thuộc tính trong constructor (cần thiết cho các Entity của TypeORM)
    "strictFunctionTypes": false, // Tắt kiểm tra tham số hàm nghiêm ngặt (cho phép gán Express Request vào IncomingMessage của pino-http)
    "paths": {
      "@libs/common": ["libs/common/src"],
      "@libs/common/*": ["libs/common/src/*"],
      "@libs/contract": ["libs/contract/src"],
      "@libs/contract/*": ["libs/contract/src/*"],
      "@libs/temporal": ["libs/temporal/src"],
      "@libs/temporal/*": ["libs/temporal/src/*"]
    }
  }
}
