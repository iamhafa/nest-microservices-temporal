# System Configuration
NODE_ENV= # Environment mode (development, production, test)

# Security & Authentication
JWT_SECRET= # Secret key for signing JSON Web Tokens (JWT)
JWT_EXPIRES_IN= # Token validity period (e.g., 6h, 1d)

# API Gateway Rate Limiting
RATE_LIMIT_TTL= # Time window size in milliseconds (e.g., 60000 = 1 minute)
RATE_LIMIT_MAX_REQUESTS_PER_IP= # Maximum allowed requests per IP address within the time window

# Message Broker (RabbitMQ)
RABBITMQ_URL= # Connection string for RabbitMQ broker

# Workflow Orchestration (Temporal)
TEMPORAL_HOST= # Temporal cluster gRPC endpoint
TEMPORAL_NAMESPACE= # Temporal namespace for isolated environments

# Centralized Logging (Grafana Loki)
LOKI_URL= # Grafana Loki server push URL

# Redis
REDIS_URL=