# System Configuration
NODE_ENV= # Environment mode (development, production, test)

# Security & Authentication
JWT_SECRET= # Secret key for signing JSON Web Tokens (JWT)
JWT_EXPIRES_IN= # Token validity period (e.g., 6h, 1d)

# API Gateway Rate Limiting
RATE_LIMIT_TTL= # Time window size in milliseconds (e.g., 60000 = 1 minute)
RATE_LIMIT_MAX_REQUESTS_PER_IP= # Maximum allowed requests per IP address within the time window

# Message Broker (RabbitMQ)
RABBITMQ_URL= # Connection string for RabbitMQ broker

# Workflow Orchestration (Temporal)
TEMPORAL_HOST= # Temporal cluster gRPC endpoint
TEMPORAL_NAMESPACE= # Temporal namespace for isolated environments

# Centralized Logging (Grafana Loki)
LOKI_URL= # Grafana Loki server push URL

# Redis
REDIS_URL= # Connection string for Redis cache

# Stripe (Payment Service)
STRIPE_SECRET_KEY= # Stripe API Secret Key
STRIPE_TIMEOUT= # Stripe request timeout in ms (e.g., 30000)

# Database Configuration (PostgreSQL)
DB_HOST= # PostgreSQL host address
DB_PORT= # PostgreSQL port (e.g., 5432)
DB_USER= # PostgreSQL username
DB_PASS= # PostgreSQL password

ORDER_DB_NAME= # Database name for Order Service
INVENTORY_DB_NAME= # Database name for Inventory Service
PRODUCT_DB_NAME= # Database name for Product Service
SHIPPING_DB_NAME= # Database name for Shipping Service
USER_DB_NAME= # Database name for User Service
PAYMENT_DB_NAME= # Database name for Payment Service