{
  "mcpServers": {
    "mcp-product-service-db": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "env": {
        "PGHOST": "${DB_HOST:-localhost}",
        "PGPORT": "${DB_PORT:-5432}",
        "PGUSER": "${DB_USER:-postgres}",
        "PGPASSWORD": "${DB_PASSWORD:-postgres}",
        "PGDATABASE": "nest-temporal-product-service"
      }
    },
    "mcp-order-service-db": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres"
