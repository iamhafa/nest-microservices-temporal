        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "env": {
        "PGHOST": "${DB_HOST:-localhost}",
        "PGPORT": "${DB_PORT:-5432}",
        "PGUSER": "${DB_USER:-postgres}",
        "PGPASSWORD": "${DB_PASSWORD:-postgres}",
        "PGDATABASE": "nest-temporal-user-service"
      }
    },
    "mcp-stripe": {
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp"
      ],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      }
    }
  }
