{
  "name": "nest-microservices-temporal",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS Microservices with Temporal",
  "license": "ISC",
  "author": "iamhafa",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "nest build",
    "format": "oxfmt \"apps/**/*.{ts,json}\" \"libs/**/*.{ts,json}\" \"*.json\" \".*.json\"",
    "format:check": "oxfmt --check \"apps/**/*.{ts,json}\" \"libs/**/*.{ts,json}\" \"*.json\" \".*.json\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^9.1.0",
    "@golevelup/nestjs-stripe": "^3.0.0",
    "@nestjs-redis/client": "^1.4.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/idempotency": "^0.0.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@prometheus-io/client": "^0.16.1",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^0.10.9",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cockatiel": "^3.2.1",
    "helmet": "^8.3.0",
    "lodash": "^4.18.1",
    "nestjs-cls": "^6.3.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-temporal-core": "^3.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-loki": "^3.0.0",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "stripe": "^21.0.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/swagger": "^12.0.3",
    "@nestjs/testing": "^12.2.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^25.9.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.89.0",
    "pino-pretty": "^13.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.20.0"
}
